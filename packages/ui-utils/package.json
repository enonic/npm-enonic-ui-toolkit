{
  "name": "@enonic/ui-utils",
  "version": "0.1.0",
  "description": "Framework-free helpers for Enonic UIs: strings, URLs, dates, requests, i18n",
  "keywords": [
    "enonic",
    "i18n",
    "typescript",
    "utils"
  ],
  "homepage": "https://github.com/enonic/npm-enonic-ui-toolkit#readme",
  "bugs": {
    "url": "https://github.com/enonic/npm-enonic-ui-toolkit/issues"
  },
  "license": "Apache-2.0",
  "author": "Enonic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enonic/npm-enonic-ui-toolkit.git",
    "directory": "packages/ui-utils"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "vp pack && node ../../scripts/assert-externals.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
