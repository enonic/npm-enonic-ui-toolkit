{
  "name": "@enonic/ui-kit",
  "version": "0.4.0",
  "description": "Composite React components with behaviour: the dialog shell and its confirmations, layouts, toolbars, browse screens",
  "keywords": [
    "components",
    "enonic",
    "preact",
    "react",
    "tailwind",
    "ui"
  ],
  "homepage": "https://github.com/enonic/npm-enonic-ui-toolkit#readme",
  "bugs": {
    "url": "https://github.com/enonic/npm-enonic-ui-toolkit/issues"
  },
  "license": "Apache-2.0",
  "author": "Enonic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enonic/npm-enonic-ui-toolkit.git",
    "directory": "packages/ui-kit"
  },
  "files": [
    "dist",
    "preset.css"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preset.css": "./preset.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "vp pack && node ../../scripts/assert-externals.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@enonic/ui-utils": "workspace:^",
    "lucide-react": "^1.48.0"
  },
  "devDependencies": {
    "@enonic/ui": "^1.4.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@storybook/preact-vite": "~10.6.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "preact": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@enonic/ui": "^1.4.0",
    "preact": ">=10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
