# Not boilerplate: oxfmt reads `indent_size` from here, so this file sets the workspace's
# 2-space indent. `vite.config.ts` owns the rest of the format configuration.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
